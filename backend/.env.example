# Copy this file to .env and fill in the values. Never commit .env.
# On a hosting service, set these as environment variables instead of uploading a file.

# Gemini (Google AI Studio). For production, use a separate key in a project with billing (paid tier)
# turned on, restricted to the Generative Language API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server
PORT=4000
# The frontend address(es) allowed to call this server, separated by commas.
FRONTEND_ORIGIN=http://localhost:5173

# Sign-in. Make a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different secret in production.
JWT_SECRET=

# PostgreSQL. Write special characters in the password URL-encoded (for example # as %23).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sangyin

# Email (Resend). Until you verify a domain, use the test sender and send only to your own Resend address.
RESEND_API_KEY=
EMAIL_FROM=Sangyin AI <onboarding@resend.dev>

# SMS (Africa's Talking). "sandbox" sends to their online simulator only.
AT_USERNAME=sandbox
AT_API_KEY=
# AT_SENDER_ID=

# The web app's address, used for links in emails and SMS.
APP_URL=http://localhost:5173
