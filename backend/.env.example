# Copy this file to .env and fill in the values. Never commit .env.
# On a hosting service, set these as environment variables instead of uploading a file.

# Gemini (Google AI Studio). For production, use a separate key in a project with billing (paid tier)
# turned on, restricted to the Generative Language API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in turn when GEMINI_MODEL says it is overloaded ("high demand") even after retries. Leave empty for none.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# How much the model thinks before answering: LOW (fastest the model allows, the default), MEDIUM or HIGH.
GEMINI_THINKING=LOW

# Claude (Anthropic). Get a key at https://console.anthropic.com/ under API keys; it starts with "sk-ant-".
# It is the backup AI: Gemini does the work, and Claude takes over by itself when Gemini is busy, over its quota,
# not answering, or its key or billing is refused. Leave the key empty for no backup (Gemini alone, as before).
# Check it works with:  npm run claude
ANTHROPIC_API_KEY=
# Which Claude model. claude-haiku-5-5 is cheaper and faster; claude-opus-5-5 is the most able and costs the most.
ANTHROPIC_MODEL=claude-sonnet-5-5
# After Claude has had to take over, requests go straight to Claude for this many minutes, then Gemini is tried again.
AI_BACKUP_COOLDOWN_MINUTES=5
# The most times Claude is called in one day (UTC) by the whole server; after that it is not used until the next
# day. The count starts again if the server restarts, so ALSO set a monthly spending limit in the Anthropic
# console (Settings, then Limits): that is the real ceiling on what Claude can cost.
AI_BACKUP_MAX_CALLS_PER_DAY=300

# Server
PORT=4000
# The frontend address(es) allowed to call this server, separated by commas.
FRONTEND_ORIGIN=http://localhost:5173

# Sign-in. Make a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different secret in production.
JWT_SECRET=

# PostgreSQL. Write special characters in the password URL-encoded (for example # as %23).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sangyin

# Email, by one of two services. A Gmail account is used when both of its lines are filled in; otherwise Resend.
#
# 1. A Gmail account. A stop-gap for the testing period: it needs no domain, and can send to anyone, up to about
#    500 emails a day. Emails arrive from the Gmail address itself, shown as "Sangezi Academia".
#    To get the app password: sign in to the Gmail account, open Google Account > Security, turn on 2-Step
#    Verification, then open "App passwords" and create one named "Sangezi Academia". Google shows 16 letters
#    once: paste them here (with or without the spaces). It is not the account's normal password.
#    Check it with:  npm run email -- someone@example.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The most emails sent through Gmail in one day (UTC), so the account is not restricted by Google.
GMAIL_MAX_SENDS_PER_DAY=400
# Only when both services are filled in: which to use, gmail or resend. Left empty, Gmail.
EMAIL_PROVIDER=
#
# 2. Resend. The proper answer later: once you own a domain and verify it with Resend, emails come from your own
#    address. Until a domain is verified, Resend delivers only to the Resend account's own address.
# RESEND_FROM is who every email comes from. Left empty, the older EMAIL_FROM is used if set, then
# "Sangezi Academia <onboarding@resend.dev>".
RESEND_API_KEY=
RESEND_FROM=Sangezi Academia <onboarding@resend.dev>

# SMS (Africa's Talking). "sandbox" sends to their online simulator only.
AT_USERNAME=sandbox
AT_API_KEY=
# AT_SENDER_ID=

# Temporary sign-up for the testing period (backend/src/signup). Set SIGNUP_ENABLED=false to switch it off:
# the sign-up form disappears from the sign-in page and the server refuses sign-ups.
# The person chooses to get one code by email or by text message (SMS), using the settings above:
# - email is offered when an email sender is set up (Gmail or Resend);
# - text message is offered when AT_API_KEY is set and AT_USERNAME is a live account (not "sandbox"), and only to
#   numbers in Uganda, Kenya, Tanzania, Rwanda and South Sudan.
# On a live server with neither, sign-up closes itself.
SIGNUP_ENABLED=true
# The Africa's Talking sandbox sends texts to their online simulator, not to phones, so on the live site it is
# not offered. Set this to true to offer it anyway and try it out (the page then says texts go to the simulator).
SIGNUP_ALLOW_SANDBOX_SMS=false
# Each text message costs money: the most sign-up texts sent in one hour and in one day, to everyone together.
SIGNUP_MAX_SMS_PER_HOUR=30
SIGNUP_MAX_SMS_PER_DAY=150
# The most sign-up codes the server sends in one hour, by email and text message together.
SIGNUP_MAX_SENDS_PER_HOUR=60
# The most sign-up requests in 15 minutes from one address as the server sees it (often an address the website's
# network shares between all visitors, so keep it high).
SIGNUP_MAX_REQUESTS_PER_ADDRESS=300

# The web app's address, used for links in emails and SMS.
APP_URL=http://localhost:5173
